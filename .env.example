# Copy this file to .env before running Docker Compose.
# Use long, unique values and never commit the resulting .env file.
POSTGRES_PROD_PASSWORD=replace-with-a-long-production-database-password
POSTGRES_TEST_PASSWORD=replace-with-a-different-long-test-database-password

# Use two different random passphrases of at least 32 characters. Losing a key
# makes that environment's encrypted backups impossible to restore.
BACKUP_PROD_ENCRYPTION_KEY=replace-with-a-long-unique-production-backup-key
BACKUP_TEST_ENCRYPTION_KEY=replace-with-a-different-long-unique-test-backup-key
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# Local HTTP development uses false. Set true behind HTTPS/Cloudflare.
COOKIE_SECURE=false

# Comma-separated browser origins and hosts accepted by the API.
APP_ALLOWED_ORIGINS=http://localhost:8080
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# Session lifetime in hours.
SESSION_TTL_HOURS=12
