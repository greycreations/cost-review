# Cost Review configuration
# 1. Copy or rename this file to .env in the same folder as docker-compose.yml.
# 2. Fill in the six empty values below the CHANGE_ME comments.
# 3. Keep a secure copy of the two backup keys outside this server.
# 4. Run: docker compose up --detach --wait

# Published Cost Review image version. Normally you should leave this unchanged.
COST_REVIEW_VERSION=0.4.1

# CHANGE_ME: Use different passwords of at least 32 letters and digits. No spaces.
POSTGRES_PROD_PASSWORD=
POSTGRES_TEST_PASSWORD=

# CHANGE_ME: Use two different keys of at least 32 letters and digits. These keys are
# required when restoring encrypted backups, including on a fresh installation.
BACKUP_PROD_ENCRYPTION_KEY=
BACKUP_TEST_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# CHANGE_ME: Address used to open Cost Review. Change both values.
# Example: http://192.168.1.41:8080 and 192.168.1.41
GATEWAY_PORT=8080
COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=
APP_ALLOWED_HOSTS=
SESSION_TTL_HOURS=12

# Advanced Docker network settings. Normally you should leave these unchanged.
EDGE_SUBNET=172.30.0.0/24
EDGE_GATEWAY_IP=172.30.0.10
PROD_DATA_SUBNET=172.31.0.0/24
TEST_DATA_SUBNET=172.32.0.0/24
