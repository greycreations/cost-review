# Published Cost Review image version. Prefer an immutable release version.
COST_REVIEW_VERSION=0.3.2

POSTGRES_PROD_PASSWORD=replace-with-a-long-production-database-password
POSTGRES_TEST_PASSWORD=replace-with-a-different-long-test-database-password

# Use two different random passphrases of at least 32 characters. Store these
# outside the server as well: encrypted backups cannot be restored without them.
BACKUP_PROD_ENCRYPTION_KEY=replace-with-a-long-unique-production-backup-key
BACKUP_TEST_ENCRYPTION_KEY=replace-with-a-different-long-unique-test-backup-key
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

GATEWAY_PORT=8080
COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=http://localhost:8080
APP_ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_TTL_HOURS=12

EDGE_SUBNET=172.30.0.0/24
EDGE_GATEWAY_IP=172.30.0.10
PROD_DATA_SUBNET=172.31.0.0/24
TEST_DATA_SUBNET=172.32.0.0/24
