# Copy this file to .env before running Docker Compose.
# Use long, unique values and never commit the resulting .env file.
POSTGRES_PROD_PASSWORD=replace-with-a-long-production-database-password
POSTGRES_TEST_PASSWORD=replace-with-a-different-long-test-database-password

# Local HTTP development uses false. Set true behind HTTPS/Cloudflare.
COOKIE_SECURE=false

# Comma-separated browser origins and hosts accepted by the API.
APP_ALLOWED_ORIGINS=http://localhost:8080
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# Session lifetime in hours.
SESSION_TTL_HOURS=12
